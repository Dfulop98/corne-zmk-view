#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  Q  |  W  |  E  |  R  |  T  |   |  Y  |  U   |  I  |  O  |  P  | BKSP |
            // |  |  A  |  S  |  D  |  F  |  G  |   |  H  |  J   |  K  |  L  |  ;  |  '   |
            // | SHFT |  Z  |  X  |  C  |  V  |  B  |   |  N  |  M   |  ,  |  .  |  /  | ESC  |
            //                    | GUI | LWR | SPC |   | ENT | RSE  | ALT |

            bindings = <
&kp TAB         &kp Q  &kp W  &kp E     &kp R  &kp T        &kp Y    &kp U  &kp I          &kp O    &kp P     &kp BSPC
&kp LEFT_SHIFT  &kp A  &kp S  &kp D     &kp F  &kp G        &kp H    &kp J  &kp K          &kp L    &kp SEMI  &kp SQT
&kp LCTRL       &kp Z  &kp X  &kp C     &kp V  &kp B        &kp N    &kp M  &kp COMMA      &kp DOT  &kp FSLH  &kp ESC
                              &kp LGUI  &mo 1  &kp SPACE    &kp RET  &mo 2  &kp RIGHT_ALT
            >;
        };

        number_fn {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  !  |  @  |  #  |  $  |  %  |   |  ^  |  &  |  *  |  (  |  )  | BKSP |
            // | CTRL |     |     |     |     |     |   |  -  |  =  |  [  |  ]  |  \  |  `   |
            // | SHFT |     |     |     |     |     |   |  _  |  +  |  {  |  }  | "|" |  ~   |
            //                    | GUI |     | SPC |   | ENT |     | ALT |

            bindings = <
&kp N0   &kp NUMBER_1  &kp NUMBER_2     &kp NUMBER_3       &kp NUMBER_4  &kp N5              &kp NUMBER_6  &kp N7      &kp N8           &kp N9        &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS
&kp F1   &kp F2        &kp F3           &kp F3             &kp F4        &kp F5              &kp F6        &kp F7      &kp F8           &kp F9        &kp LEFT_BRACKET      &kp RIGHT_BRACKET
&kp F11  &kp F12       &kp K_VOLUME_UP  &kp K_VOLUME_DOWN  &kp K_MUTE    &kp K_PLAY_PAUSE    &kp K_BACK    &kp K_NEXT  &kp PRINTSCREEN  &kp CAPSLOCK  &kp LEFT_BRACE        &kp RIGHT_BRACE
                                        &kp LGUI           &trans        &kp SPACE           &kp ENTER     &trans      &kp RALT
            >;
        };

        arrow_layer {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  1  |  2  |  3  |  4  |  5  |   |  6  |  7  |  8  |  9  |  0  | BKSP |
            // | BTCLR| BT1 | BT2 | BT3 | BT4 | BT5 |   | LFT | DWN |  UP | RGT |     |      |
            // | SHFT |     |     |     |     |     |   |     |     |     |     |     |      |
            //                    | GUI |     | SPC |   | ENT |     | ALT |

            bindings = <
&bt BT_CLR    &kp K_WWW         &kp UP_ARROW    &trans           &trans          &msc SCRL_UP       &trans     &kp RIGHT_BRACKET  &kp NON_US_BACKSLASH  &kp EQUAL         &kp INSERT  &kp DELETE
&bt BT_SEL 1  &kp LEFT_ARROW    &kp DOWN_ARROW  &kp RIGHT_ARROW  &kp F7          &msc SCRL_DOWN     &kp LEFT   &kp DOWN           &kp UP                &kp RIGHT         &kp PG_UP   &kp PAGE_DOWN
&bt BT_SEL 2  &kp K_CALCULATOR  &trans          &trans           &msc SCRL_LEFT  &msc SCRL_RIGHT    &kp MINUS  &kp RA(POUND)      &kp N0                &kp LEFT_BRACKET  &kp HOME    &kp END
                                                &kp LGUI         &trans          &kp SPACE          &kp RET    &trans             &kp RALT
            >;
        };

        layer_3 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
                        &trans  &trans  &trans    &trans  &trans  &trans
            >;
        };
    };
};
